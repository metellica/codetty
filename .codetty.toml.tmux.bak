layout = "focus-big"
focus = "mnemogs"

[template.dev]

  [[template.dev.window]]
  name = "copilot"
  command = "copilot --allow-all"

  [[template.dev.window]]
  name = "git"
  command = "lazygit"

  [[template.dev.window]]
  name = "code"
  command = "nvim ."

  [[template.dev.window]]
  name = "shell"

[[session]]
name = "mnemogs"
type = "tmux"
tmux_session = "mnemogs"
template = "dev"
dir = "/root/logsim-mount/MnemoGS"

[[session]]
name = "simone_log"
type = "tmux"
tmux_session = "simone_log"
template = "dev"
dir = "/root/logsim-mount/simone_log"

[[session]]
name = "taskmanager"
type = "tmux"
tmux_session = "taskmanager"
template = "dev"
dir = "/root/logsim-mount/SimOneTaskManager"

[[session]]
name = "codetty"
type = "tmux"
tmux_session = "codetty"
template = "dev"
dir = "/root/logsim-mount/codetty"

[[session]]
name = "reverseproxy"
type = "tmux"
tmux_session = "reverseproxy"
template = "dev"
dir = "/root/logsim-mount/simone_reverse_proxy"

[[session]]
name = "51sim-nurec"
type = "tmux"
tmux_session = "51sim-nurec"
template = "dev"
dir = "/root/logsim-mount/51sim-nurec"

[[session]]
name = "cybertron"
type = "tmux"
tmux_session = "cybertron"
template = "dev"
dir = "/root/logsim-mount/Cybertron"
